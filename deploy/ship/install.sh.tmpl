#!/bin/sh
# Atelier server setup. It downloads atelier-setup for this machine, checks its checksum and starts it.
#
#   curl -fsSL https://updates.atelierhq.dev/install | sudo sh
#
# With sudo, the wizard can install or start Docker itself. Anything after `sh -s --` goes to atelier-setup, for example
# `... | sudo sh -s -- doctor`.
# It is short, so read it first if you like. To pin what you run, download it and compare its sha256 with the one on the
# release page, then run the file: sh install.sh
set -eu

VERSION="@VERSION@"
BASE="${ATELIER_SETUP_BASE:-https://updates.atelierhq.dev/setup}/$VERSION"
SUMS="@SUMS@"

say() { printf '%s\n' "$*" >&2; }
fail() { say "atelier-setup: $*"; exit 1; }

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$os" in
  linux|darwin) ;;
  *) fail "unsupported system: $os (Linux and macOS are supported)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
  *) fail "unsupported processor: $(uname -m)" ;;
esac
name="atelier-setup-$os-$arch"

command -v curl >/dev/null 2>&1 || fail "curl is needed to download atelier-setup"

want=$(printf '%s\n' "$SUMS" | awk -v n="$name" '$2 == n { print $1 }')
[ -n "$want" ] || fail "no build of atelier-setup for $os/$arch"

if [ "$(id -u)" = 0 ]; then dest=/usr/local/bin; else dest="${HOME:?}/.local/bin"; fi
mkdir -p "$dest"
tmp=$(mktemp "$dest/.atelier-setup.XXXXXX") || fail "cannot write to $dest"
trap 'rm -f "$tmp"' EXIT INT TERM

say "Downloading $name $VERSION ..."
curl -fsSL "$BASE/$name" -o "$tmp" || fail "download failed: $BASE/$name"

if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum "$tmp" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 "$tmp" | awk '{ print $1 }')
else fail "sha256sum or shasum is needed to check the download"; fi
[ "$got" = "$want" ] || fail "the download does not match its checksum (got $got, expected $want); nothing was run"

chmod 755 "$tmp"
mv -f "$tmp" "$dest/atelier-setup"
trap - EXIT INT TERM
say "Installed $dest/atelier-setup"
case ":$PATH:" in *":$dest:"*) ;; *) say "Add $dest to your PATH to run it later by name." ;; esac

# Piped from curl, stdin is the script, not the keyboard: give the wizard the terminal back.
if [ ! -t 0 ] && (: </dev/tty) 2>/dev/null; then
  exec "$dest/atelier-setup" "$@" </dev/tty
fi
exec "$dest/atelier-setup" "$@"
