{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts"
  ]
}
