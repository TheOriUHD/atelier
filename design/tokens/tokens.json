    "settings-nav-width": 192,
    "settings-content-padding": 24,
    "settings-row-padding-y": 12,
    "dialog-width": 520,
    "dialog-padding": 24,
    "palette-width": 672,
    "artifact-panel-inset": 8,
    "popover-padding": 4,
