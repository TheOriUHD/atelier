    "avatar": { "xs": 20, "sm": 24, "md": 32, "lg": 40 },
    "checkbox": { "sm": 18, "md": 20 }
  },
  "motion": {
    "duration": { "fast": 60, "snap": 120, "base": 200, "sheet": 300, "slow": 450, "actions-in-delay": 100 },
    "easing": {
      "out": "cubic-bezier(0.165, 0.84, 0.44, 1)",
      "snap": "cubic-bezier(0.32, 0.72, 0, 1)",
      "overshoot": "cubic-bezier(0.34, 1.3, 0.64, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "out-cubic": "cubic-bezier(0.215, 0.61, 0.355, 1)",
