    "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace", "role": "code, diffs, terminal" },
    "dyslexic": { "family": "OpenDyslexic", "fallback": "\"Comic Sans MS\", sans-serif", "role": "accessibility option" },
    "system": { "family": "system-ui", "fallback": "-apple-system, \"Segoe UI\", Roboto, sans-serif", "role": "system option" }
  },
