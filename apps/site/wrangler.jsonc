{
  // The public website: static files only. Deploy with `npx wrangler deploy -c apps/site/wrangler.jsonc`.
  "name": "atelier-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Reachable only through the custom domain (which sits behind Cloudflare Access until the project goes public).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "atelierhq.dev", "custom_domain": true }],
}
