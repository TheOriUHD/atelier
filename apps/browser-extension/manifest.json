{
  "manifest_version": 3,
  "name": "Atelier for Chrome",
  "description": "Lets Atelier work in web pages for you, in tabs of its own, while you keep using your browser.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "debugger", "scripting", "webNavigation", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "icons": { "128": "icon-128.png" }
}
