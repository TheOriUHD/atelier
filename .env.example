# Copy to .env.local (gitignored) to run the live provider smoke tests:
#   pnpm exec vitest run --project @atelier/core packages/core/src/providers/live.test.ts
# Atelier itself never reads this file; in the app, add providers in Settings › Providers.

# ANTHROPIC_API_KEY=
# ATELIER_LIVE_ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# ATELIER_LIVE_OPENAI_MODEL=gpt-5-mini
# ATELIER_LIVE_OLLAMA_URL=http://gpu-box:11434
# ATELIER_LIVE_OLLAMA_MODEL=
# ATELIER_LIVE_LLAMACPP_URL=http://gpu-box:8080
# ATELIER_LIVE_COMPAT_URL=https://openrouter.ai/api/v1
# ATELIER_LIVE_COMPAT_KEY=
# ATELIER_LIVE_COMPAT_MODEL=
